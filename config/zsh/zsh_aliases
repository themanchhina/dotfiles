# AI Coding Agents & Multiplexer
alias hr="herdr"
alias gi="agy --dangerously-skip-permissions"
alias co="codex --yolo"
alias cc="claude --dangerously-skip-permissions"

# Editor & Tools
alias vi="nvim"
alias vim="nvim"
alias nv="nvim"
alias lg="lazygit"

# Docker Agent Helpers
# Sets HERDR_AGENT on the host command so Herdr's screen manifests detect agents running in containers
unalias hdocker hdexec hdrun 2>/dev/null || true

hdocker() {
  local agent="$1"
  shift
  HERDR_AGENT="$agent" docker "$@"
}

hdexec() {
  local container="$1"
  local agent="$2"
  shift 2
  HERDR_AGENT="$agent" docker exec -it "$container" "$agent" "$@"
}

hdrun() {
  local agent="$1"
  shift
  HERDR_AGENT="$agent" docker run -it "$@"
}

# Dotfiles & System Management (macOS)
if [[ "$(uname -s)" == "Darwin" ]]; then
  DOTFILES_DIR="${DOTFILES_DIR:-$HOME/code/daman/dotfiles}"
  alias rebuild="$DOTFILES_DIR/scripts/rebuild.sh"
  alias update="$DOTFILES_DIR/scripts/update.sh"
  alias sync-brew="$DOTFILES_DIR/scripts/sync-brew.sh"
  alias sync-remote="$DOTFILES_DIR/scripts/sync-remote.sh"
  alias nix-clean="nix-collect-garbage --delete-older-than 30d"
fi

# Local alias overrides (machine-specific)
[[ ! -f ~/.zsh_aliases_local ]] || source ~/.zsh_aliases_local
