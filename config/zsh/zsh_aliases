# AI Coding Agents & Multiplexer
alias hr="herdr"

_hagent() {
  local -a base=("${(@s/ /)1}")
  shift
  if [[ $# -gt 0 && "$1" != -* ]]; then
    local name="$1"; shift
    if [[ -n "${HERDR_PANE_ID:-}" ]]; then
      command herdr pane rename "$HERDR_PANE_ID" "$name" >/dev/null 2>&1
      local clean_name="${name:l}"
      clean_name="${clean_name// /_}"
      clean_name="${clean_name//[^a-z0-9_-]/}"
      [[ ! "$clean_name" =~ ^[a-z] ]] && clean_name="a_${clean_name}"
      clean_name="${clean_name[1,32]}"
      (
        for _ in {1..25}; do
          command herdr agent rename "$HERDR_PANE_ID" "$clean_name" >/dev/null 2>&1 && break
          sleep 0.2
        done
      ) >/dev/null 2>&1 &!
    fi
  fi
  command "${base[@]}" "$@"
}

gi() { _hagent "agy --dangerously-skip-permissions" "$@"; }
co() { _hagent "codex --yolo" "$@"; }
cc() { _hagent "claude" "$@"; }

