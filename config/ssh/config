IgnoreUnknown UseKeychain

# Include local uncommitted configurations (machine-specific or private servers)
Include ~/.ssh/config.local

# Keep IdentitiesOnly per-host: globally it also excludes agent keys.
Host github.com themanchhina
  HostName github.com
  User git
  IdentityFile ~/.ssh/daman
  IdentitiesOnly yes

Host dchhina
  HostName github.com
  User git
  IdentityFile ~/.ssh/bluecrew
  IdentitiesOnly yes

Host amarpreet
  HostName github.com
  User git
  IdentityFile ~/.ssh/amarpreet
  IdentitiesOnly yes

Host aamir
  User daman
  HostName home.aamirahmad.me
  Port 22000
  IdentityFile ~/.ssh/aamir

Host home
  User daman
  HostName home.damanchhina.com
  IdentityFile ~/.ssh/daman

Host india
  User daman
  HostName india.damanchhina.com
  IdentityFile ~/.ssh/daman

Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 15
  ServerAliveCountMax 4
  TCPKeepAlive yes
  SendEnv TERM_PROGRAM
