IgnoreUnknown UseKeychain

# Per-host, not global: globally IdentitiesOnly also excludes every agent key,
# leaving unlisted hosts with no identity at all. Above the Include so a local
# override cannot disable the key isolation these three GitHub accounts need.
Host github.com themanchhina
  HostName github.com
  User git
  IdentityFile ~/.ssh/daman
  IdentitiesOnly yes

Host dchhina
  HostName github.com
  User git
  IdentityFile ~/.ssh/bluecrew
  IdentitiesOnly yes

Host amarpreet
  HostName github.com
  User git
  IdentityFile ~/.ssh/amarpreet
  IdentitiesOnly yes

# The bare `Host *` is required: an Include inherits the enclosing block.
Host *
Include ~/.ssh/config.local

Host aamir
  User daman
  HostName home.aamirahmad.me
  Port 22000
  IdentityFile ~/.ssh/aamir
  IdentitiesOnly yes

Host home
  User daman
  HostName home.damanchhina.com
  IdentityFile ~/.ssh/daman
  IdentitiesOnly yes

Host india
  User daman
  HostName india.damanchhina.com
  IdentityFile ~/.ssh/daman
  IdentitiesOnly yes

Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 15
  ServerAliveCountMax 4
  TCPKeepAlive yes
  SendEnv TERM_PROGRAM
